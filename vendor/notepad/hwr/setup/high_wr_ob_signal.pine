//@version=5
indicator("오더블록 리테스트 [HWR OB]", shorttitle="HWR OB", overlay=true, scale=scale.right, max_labels_count=500, max_boxes_count=80)

// ─────────────────────────────────────────────
// 추세 방향의 피벗 자리에 수요/공급 구역을 두고,
// 한 번 빠져나간 뒤 다시 닿아 거부할 때만 진입.
// 거래량 매수%가 약한 블록은 버림.
// 개념 재구성. 원본 복제 아님. 콤보와 같이 켜지 마세요.
// ─────────────────────────────────────────────

grpOb = "1. 오더블록"
obLook     = input.int(7, "피벗 봉", minval=3, maxval=20, group=grpOb)
minBuyPct  = input.float(55.0, "롱 최소 매수 %", minval=0, maxval=90, step=5, group=grpOb, tooltip="피벗~확정 구간의 양봉 거래량 비중. 콤보(50)보다 조금 높여 약한 블록을 뺍니다.")
minSellPct = input.float(55.0, "숏 최소 매도 %", minval=0, maxval=90, step=5, group=grpOb)
useTrailDir = input.bool(true, "트레일 방향과 같을 때만", group=grpOb)
waitLeave  = input.bool(true, "한 번 빠져나간 뒤만", group=grpOb, tooltip="생기자마자 첫 터치는 안 잡습니다. 콤보 OB가 지저분했던 지점입니다.")
oncePerOb  = input.bool(true, "블록당 한 번만", group=grpOb)
killOnBreak = input.bool(true, "종가가 블록을 깨면 삭제", group=grpOb)

grpTrail = "1b. 추세 트레일"
atrLen   = input.int(10, "ATR 기간", minval=1, group=grpTrail)
trailKey = input.float(1.20, "트레일 민감도", minval=0.4, step=0.05, group=grpTrail)
htfTf    = input.timeframe("60", "상위 타임프레임", group=grpTrail)

grpMom = "2. 확인"
adxLen = input.int(14, "ADX 기간", minval=2, group=grpMom)
adxMin = input.float(16.0, "최소 ADX", minval=1, step=0.5, group=grpMom)
requireHtf = input.bool(true, "상위TF 방향 필수", group=grpMom)
requireAdx = input.bool(true, "ADX 필수 (횡보 제외)", group=grpMom)
requireReject = input.bool(true, "양/음봉·거부봉만 진입", group=grpMom)

grpVol = "3. 손절·익절 박스"
swingLen = input.int(8, "스윙 손절 봉", minval=3, maxval=30, group=grpVol)
slPadAtr = input.float(0.12, "손절 여유 ATR", minval=0.0, step=0.02, group=grpVol)
slMinAtr = input.float(0.90, "손절 최소 ATR", minval=0.4, step=0.05, group=grpVol)
slMaxAtr = input.float(2.20, "손절 최대 ATR", minval=0.8, step=0.05, group=grpVol)
useObSl  = input.bool(true, "블록 바깥을 손절에 반영", group=grpVol, tooltip="롱은 수요 바닥, 숏은 공급 천장. 너무 멀면 ATR 최대로 가둡니다.")
tp1R     = input.float(0.80, "TP1 (R)", minval=0.3, step=0.05, group=grpVol, tooltip="손절 거리 대비. 대시보드 승률은 TP1 먼저 닿았는지.")
tp2R     = input.float(2.00, "TP2 (R)", minval=0.5, step=0.1, group=grpVol)
tp3R     = input.float(3.20, "TP3 (R)", minval=0.8, step=0.1, group=grpVol)
q1Pct    = input.float(30.0, "TP1 비중 %", minval=0, maxval=100, step=5, group=grpVol)
q2Pct    = input.float(40.0, "TP2 비중 %", minval=0, maxval=100, step=5, group=grpVol)
slToBe   = input.bool(true, "TP1 후 손절을 본절로", group=grpVol)
useTrailSl = input.bool(false, "TP1 후 구조 트레일", group=grpVol)
trailBars = input.int(6, "구조 트레일 봉", minval=3, maxval=20, group=grpVol)
q3Pct    = math.max(100.0 - q1Pct - q2Pct, 0.0)
tpCount  = q3Pct < 0.5 ? 2 : 3

grpEx = "3b. 청산"
exitOnObBreak = input.bool(true, "진입한 블록이 깨지면 청산", group=grpEx)
flipOnOpp = input.bool(true, "반대 신호면 뒤집기", group=grpEx)
minHoldBars = input.int(1, "최소 보유 봉", minval=1, group=grpEx)

grpSig = "4. 신호 품질"
cooldownBars = input.int(6, "신호 쿨다운(봉)", minval=1, group=grpSig)
minConv = input.int(60, "최소 확신도", minval=0, maxval=90, group=grpSig)

grpStat = "5. 측정기간"
statMode = input.string("최근 N일", "측정 방식", options=["전체", "최근 N일", "기간 지정"], group=grpStat)
statDays = input.int(60, "최근 N일", minval=1, maxval=3650, group=grpStat)
statFrom = input.time(timestamp("01 Jan 2026 00:00"), "시작", group=grpStat)
statTo   = input.time(timestamp("12 Sep 2026 23:59"), "종료", group=grpStat)
sessTz   = input.string("Asia/Seoul", "타임존", options=["Asia/Seoul", "America/New_York", "Europe/London", "UTC"], group=grpStat)

grpUi = "6. 표시"
showTrail = input.bool(true, "ATR 트레일 표시", group=grpUi)
showObBox = input.bool(true, "오더블록 표시", group=grpUi)
showBoxes = input.bool(true, "TP/SL 구간 표시", group=grpUi)
showDash  = input.bool(true, "대시보드 표시", group=grpUi)
alertEntry = input.bool(false, "진입 알림", group=grpUi, tooltip="끄면 롱/숏 진입 알림을 보내지 않습니다. 차트 라벨은 그대로입니다.")
alertExit  = input.bool(false, "청산 알림", group=grpUi, tooltip="끄면 청산 알림을 보내지 않습니다.")
dashPosIn = input.string("오른쪽 위", "테이블 위치", options=["오른쪽 위", "오른쪽 아래", "왼쪽 위", "왼쪽 아래", "가운데 위", "가운데 아래", "오른쪽 중간", "왼쪽 중간"], group=grpUi)
bullCol = input.color(color.new(#26a69a, 0), "롱 색", group=grpUi)
bearCol = input.color(color.new(#ef5350, 0), "숏 색", group=grpUi)

atrVal = ta.atr(atrLen)
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
adxOk = adxVal > adxMin
htfEma = request.security(syminfo.tickerid, htfTf, ta.ema(close, 21)[1], barmerge.gaps_off, barmerge.lookahead_off)
htfCls = request.security(syminfo.tickerid, htfTf, close[1], barmerge.gaps_off, barmerge.lookahead_off)
htfBull = htfCls > htfEma
htfBear = htfCls < htfEma

rng = high - low
body = math.abs(close - open)
upperWick = high - math.max(close, open)
lowerWick = math.min(close, open) - low
midPx = (high + low) * 0.5
bullClose = close > open
bearClose = close < open
bodyOk = rng > 0 and body >= rng * 0.28
bullPin = rng > 0 and lowerWick >= rng * 0.34 and close >= midPx
bearPin = rng > 0 and upperWick >= rng * 0.34 and close <= midPx
bullEngulf = bullClose and close > high[1] and open <= math.max(open[1], close[1])
bearEngulf = bearClose and close < low[1] and open >= math.min(open[1], close[1])
rejectLong  = not requireReject or bullPin or bullEngulf or (bullClose and bodyOk)
rejectShort = not requireReject or bearPin or bearEngulf or (bearClose and bodyOk)
realRejL = bullPin or bullEngulf
realRejS = bearPin or bearEngulf

// ===== ATR 트레일 (콤보와 같은 개념) =====
nLoss = trailKey * atrVal
var float trail = na
float prevTr = nz(trail, close)
if close > prevTr and close[1] > prevTr
    trail := math.max(prevTr, close - nLoss)
else if close < prevTr and close[1] < prevTr
    trail := math.min(prevTr, close + nLoss)
else
    trail := close > prevTr ? close - nLoss : close + nLoss
trailBull = close > trail
trailBear = close < trail

// ===== 피벗 창 거래량 =====
f_buyPct() =>
    float buy = 0.0
    float tot = 0.0
    for i = 0 to obLook
        tot += nz(volume[i])
        buy += close[i] >= open[i] ? nz(volume[i]) : 0.0
    tot > 0 ? buy / tot * 100.0 : 50.0

ph = ta.pivothigh(high, obLook, obLook)
pl = ta.pivotlow(low, obLook, obLook)

var float demTop = na
var float demBot = na
var float demPct = na
var int demBar = na
var bool demLeft = false
var bool demUsed = false
var box bDem = na

var float supTop = na
var float supBot = na
var float supPct = na
var int supBar = na
var bool supLeft = false
var bool supUsed = false
var box bSup = na

newDem = false
newSup = false

if barstate.isconfirmed and not na(pl) and (not useTrailDir or trailBull)
    float pct = f_buyPct()
    if pct >= minBuyPct
        float t = high[obLook]
        float b = low[obLook]
        bool overlap = not na(demTop) and not (b > demTop or t < demBot)
        if not overlap
            box.delete(bDem)
            demTop := t
            demBot := b
            demPct := pct
            demBar := bar_index - obLook
            demLeft := close > t
            demUsed := false
            newDem := true
            if showObBox
                bDem := box.new(demBar, t, bar_index, b, xloc=xloc.bar_index, border_color=bullCol, border_width=1, bgcolor=color.new(bullCol, 82), text="수요  매수" + str.tostring(pct, "#") + "%", text_color=color.white, text_size=size.tiny, text_halign=text.align_right, text_valign=text.align_center)

if barstate.isconfirmed and not na(ph) and (not useTrailDir or trailBear)
    float pct = f_buyPct()
    float sellPct = 100.0 - pct
    if sellPct >= minSellPct
        float t = high[obLook]
        float b = low[obLook]
        bool overlap = not na(supTop) and not (b > supTop or t < supBot)
        if not overlap
            box.delete(bSup)
            supTop := t
            supBot := b
            supPct := sellPct
            supBar := bar_index - obLook
            supLeft := close < b
            supUsed := false
            newSup := true
            if showObBox
                bSup := box.new(supBar, t, bar_index, b, xloc=xloc.bar_index, border_color=bearCol, border_width=1, bgcolor=color.new(bearCol, 82), text="공급  매도" + str.tostring(sellPct, "#") + "%", text_color=color.white, text_size=size.tiny, text_halign=text.align_right, text_valign=text.align_center)

if not na(demTop)
    if not demLeft and close > demTop
        demLeft := true
    if killOnBreak and barstate.isconfirmed and close < demBot
        box.delete(bDem)
        demTop := na
        demBot := na
        demPct := na
        demBar := na
        demLeft := false
        demUsed := false
        bDem := na

if not na(supTop)
    if not supLeft and close < supBot
        supLeft := true
    if killOnBreak and barstate.isconfirmed and close > supTop
        box.delete(bSup)
        supTop := na
        supBot := na
        supPct := na
        supBar := na
        supLeft := false
        supUsed := false
        bSup := na

if showObBox and not na(bDem)
    box.set_right(bDem, bar_index)
if showObBox and not na(bSup)
    box.set_right(bSup, bar_index)

leftOkL = not waitLeave or demLeft
leftOkS = not waitLeave or supLeft
usedOkL = not oncePerOb or not demUsed
usedOkS = not oncePerOb or not supUsed
freshL = na(demBar) or bar_index - demBar > obLook
freshS = na(supBar) or bar_index - supBar > obLook

tapL = not na(demTop) and low <= demTop and high >= demBot
tapS = not na(supBot) and high >= supBot and low <= supTop
bounceL = close > demTop and (bullClose or close >= midPx)
bounceS = close < supBot and (bearClose or close <= midPx)

obLong = tapL and bounceL and leftOkL and usedOkL and freshL and not newDem
obShort = tapS and bounceS and leftOkS and usedOkS and freshS and not newSup

f_conf(bool isLong) =>
    float volp = isLong ? nz(demPct, 50.0) : nz(supPct, 50.0)
    int pts = 36
    pts += volp >= 70 ? 20 : volp >= 60 ? 12 : 6
    pts += (isLong ? realRejL : realRejS) ? 12 : 0
    pts += (isLong ? htfBull : htfBear) ? 12 : 0
    pts += adxOk ? 10 : 2
    pts += (isLong ? trailBull : trailBear) ? 8 : 0
    pts += adxVal >= 22 ? 6 : 0
    math.min(100, pts)

f_grade(int c) =>
    c >= 75 ? "A" : c >= 60 ? "B" : "C"

confLong = f_conf(true)
confShort = f_conf(false)
gradeLong = f_grade(confLong)
gradeShort = f_grade(confShort)

var int lastSigBar = na
cooled = na(lastSigBar) or (bar_index - lastSigBar >= cooldownBars)
htfGateL = not requireHtf or htfBull
htfGateS = not requireHtf or htfBear
adxGate = not requireAdx or adxOk
baseOk = barstate.isconfirmed and cooled and adxGate
dirOkL = not useTrailDir or trailBull
dirOkS = not useTrailDir or trailBear

longRaw = baseOk and obLong and rejectLong and htfGateL and dirOkL and confLong >= minConv and not obShort
shortRaw = baseOk and obShort and rejectShort and htfGateS and dirOkS and confShort >= minConv and not obLong
longSignal = longRaw
shortSignal = shortRaw

plot(close, "축고정", color=color.new(color.white, 100), linewidth=1, editable=false)
plot(showTrail ? trail : na, "트레일", color=trailBull ? bullCol : bearCol, linewidth=2)
bgcolor(longSignal ? color.new(bullCol, 92) : shortSignal ? color.new(bearCol, 92) : na)
alertcondition(alertEntry and longSignal, title="OB 롱", message="HWR OB LONG")
alertcondition(alertEntry and shortSignal, title="OB 숏", message="HWR OB SHORT")

swingLo = ta.lowest(low, swingLen)
swingHi = ta.highest(high, swingLen)
f_sl(bool isLong, float px) =>
    float obEdge = isLong ? nz(demBot, swingLo) : nz(supTop, swingHi)
    float structPx = isLong ? math.min(swingLo, obEdge) : math.max(swingHi, obEdge)
    float usePx = useObSl ? structPx : (isLong ? swingLo : swingHi)
    raw = isLong ? usePx - atrVal * slPadAtr : usePx + atrVal * slPadAtr
    dist = math.abs(px - raw)
    adj = math.max(atrVal * slMinAtr, math.min(atrVal * slMaxAtr, dist))
    isLong ? px - adj : px + adj
f_tpR(bool isLong, float px, float sl, float rMult) =>
    risk = math.max(math.abs(px - sl), syminfo.mintick)
    isLong ? px + risk * rMult : px - risk * rMult

var bool zLive = false
var int zDir = 0
var float zEntry = na
var float zAvg = na
var float zSl = na
var float zSlOrig = na
var float zTp1 = na
var float zTp2 = na
var float zTp3 = na
var float zObEdge = na
var int zBar = na
var int zTm = na
var bool zHit1 = false
var bool zHit2 = false
var bool zHit3 = false
var bool zBe = false
var int zLockBar = na
var box bTp1 = na
var box bTp2 = na
var box bTp3 = na
var box bSl = na
var box bAvg = na
var label tTp1 = na
var label tTp2 = na
var label tTp3 = na
var label tSl = na
var label tAvg = na
var int wins = 0
var int losses = 0
var int nBe = 0
var float sumWinR = 0.0
var float sumLossR = 0.0
var int firstTradeTime = na
var int lastCloseTime = na
int lookFrom = timenow - statDays * 24 * 60 * 60 * 1000
bool openedL = false
bool openedS = false
bool closedNow = false
int openDir = 0
bool isFlip = false
bool wantWipe = false
string closeWhy = ""
bool closeWin = false
bool closeLoss = false
bool closeBe = false
float closeR = na

f_inStat(int t) =>
    na(t) ? false : statMode == "전체" ? true : statMode == "최근 N일" ? (t >= lookFrom and t <= timenow) : (t >= statFrom and t <= statTo)
f_zone(float p1, float p2, color bg, color bd) =>
    box.new(bar_index, math.max(p1, p2), bar_index, math.min(p1, p2), xloc=xloc.bar_index, border_color=bd, border_width=1, bgcolor=bg)
f_tag(float y, color c, string name, float px) =>
    label.new(bar_index, y, name + "  " + str.tostring(px, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(c, 20), textcolor=color.white, size=size.tiny)
f_ext(b) =>
    if not na(b)
        box.set_right(b, bar_index)
    true

if zLive and barstate.isconfirmed
    bool held = bar_index - zBar >= minHoldBars
    bool touch1 = zDir == 1 ? high >= zTp1 : low <= zTp1
    bool touch2 = zDir == 1 ? high >= zTp2 : low <= zTp2
    bool touch3 = zDir == 1 ? high >= zTp3 : low <= zTp3
    if touch1 and not zHit1
        zHit1 := true
        zLockBar := bar_index
        if slToBe and tpCount >= 2
            zSl := zAvg
            zBe := true
            if showBoxes
                box.delete(bSl)
                label.delete(tSl)
                float bePad = math.max(syminfo.mintick * 4, atrVal * 0.05)
                bSl := f_zone(zAvg + bePad, zAvg - bePad, color.new(#f0c14a, 70), color.new(#f0c14a, 20))
                tSl := f_tag(zAvg, #f0c14a, "본절", zAvg)
    if tpCount >= 2 and touch2
        zHit2 := true
    if tpCount >= 3 and touch3
        zHit3 := true
    if zHit1 and useTrailSl
        float trailLv = zDir == 1 ? ta.lowest(low, trailBars) - atrVal * 0.08 : ta.highest(high, trailBars) + atrVal * 0.08
        float newSl = zDir == 1 ? math.max(zSl, math.max(zAvg, trailLv)) : math.min(zSl, math.min(zAvg, trailLv))
        if newSl != zSl
            zSl := newSl
            if showBoxes and not na(tSl)
                label.set_y(tSl, zSl)
                label.set_text(tSl, "트레일  " + str.tostring(zSl, format.mintick))
            if showBoxes and not na(bSl)
                float tPad = math.max(syminfo.mintick * 4, atrVal * 0.04)
                box.set_top(bSl, zSl + tPad)
                box.set_bottom(bSl, zSl - tPad)
    bool lastTpHit = tpCount == 1 ? zHit1 : tpCount == 2 ? zHit2 : zHit3
    bool slArmed = na(zLockBar) or bar_index > zLockBar
    bool hitSl = slArmed and (zDir == 1 ? low <= zSl : high >= zSl)
    bool obBroke = exitOnObBreak and not na(zObEdge) and (zDir == 1 ? close < zObEdge : close > zObEdge)
    bool opp = (zDir == 1 and shortSignal) or (zDir == -1 and longSignal)
    if held and (lastTpHit or hitSl or obBroke or opp)
        float fill = hitSl ? zSl : lastTpHit ? (tpCount == 1 ? zTp1 : tpCount == 2 ? zTp2 : zTp3) : close
        float pnl = zDir == 1 ? fill - zEntry : zEntry - fill
        float rNet = pnl / math.max(math.abs(zEntry - nz(zSlOrig, zSl)), syminfo.mintick)
        bool wrWin = zHit1 or zHit2 or zHit3
        bool wrBe = zBe and zHit1 and not zHit2 and not zHit3 and hitSl
        bool wrLoss = hitSl and not zHit1
        if (obBroke or opp) and not wrWin and not wrLoss
            wrWin := rNet > 0.08
            wrLoss := rNet < -0.08
            wrBe := not wrWin and not wrLoss
        if f_inStat(zTm)
            if wrWin and not wrBe
                wins += 1
                sumWinR += math.max(rNet, 0.01)
            else if wrLoss
                losses += 1
                sumLossR += math.abs(rNet)
            else
                nBe += 1
        closedNow := true
        lastCloseTime := time
        closeWhy := lastTpHit ? (zHit3 ? "TP3" : zHit2 ? "TP2" : "TP1") : hitSl ? (wrBe ? "본절" : "SL") : obBroke ? "블록붕괴" : "반대신호"
        closeWin := wrWin and not wrBe
        closeLoss := wrLoss
        closeBe := wrBe
        closeR := rNet
        wantWipe := true
        if flipOnOpp and opp
            isFlip := true
            openDir := zDir == 1 ? -1 : 1
        else
            zLive := false

if not zLive and openDir == 0 and barstate.isconfirmed
    if longSignal
        openDir := 1
    else if shortSignal
        openDir := -1

if wantWipe or (openDir != 0 and showBoxes)
    box.delete(bTp1)
    box.delete(bTp2)
    box.delete(bTp3)
    box.delete(bSl)
    box.delete(bAvg)
    label.delete(tTp1)
    label.delete(tTp2)
    label.delete(tTp3)
    label.delete(tSl)
    label.delete(tAvg)
    bTp1 := na
    bTp2 := na
    bTp3 := na
    bSl := na
    bAvg := na
    tTp1 := na
    tTp2 := na
    tTp3 := na
    tSl := na
    tAvg := na

if wantWipe and closedNow
    string resTxt = closeWhy + "  " + (closeWin ? "익절 +" : closeLoss ? "손절 " : "본절 ") + str.tostring(closeR, "#.##") + "R"
    color resCol = closeWin ? bullCol : closeLoss ? bearCol : color.new(#f0c14a, 0)
    bool below = (zDir == 1 and not closeWin) or (zDir == -1 and closeWin)
    label.new(bar_index, below ? low : high, resTxt, xloc=xloc.bar_index, style=below ? label.style_label_up : label.style_label_down, color=resCol, textcolor=color.white, size=size.tiny)

if openDir != 0
    zLive := true
    zDir := openDir
    zEntry := close
    zAvg := close
    zSl := f_sl(openDir == 1, close)
    zSlOrig := zSl
    zTp1 := f_tpR(openDir == 1, close, zSl, tp1R)
    zTp2 := f_tpR(openDir == 1, close, zSl, tp2R)
    zTp3 := f_tpR(openDir == 1, close, zSl, tp3R)
    zObEdge := openDir == 1 ? demBot : supTop
    zBar := bar_index
    zTm := time
    zHit1 := false
    zHit2 := false
    zHit3 := false
    zBe := false
    zLockBar := na
    lastSigBar := bar_index
    if openDir == 1
        demUsed := true
        openedL := true
    else
        supUsed := true
        openedS := true
    if f_inStat(time) and na(firstTradeTime)
        firstTradeTime := time
    string side = openDir == 1 ? "롱" : "숏"
    string grd = openDir == 1 ? gradeLong : gradeShort
    int cf = openDir == 1 ? confLong : confShort
    float vp = openDir == 1 ? nz(demPct, 0.0) : nz(supPct, 0.0)
    string how = isFlip ? "뒤집기 " : ""
    if openDir == 1
        label.new(bar_index, low, how + "OB " + side + " " + grd + " " + str.tostring(cf) + "%  매수" + str.tostring(vp, "#") + "%", xloc=xloc.bar_index, style=label.style_label_up, color=bullCol, textcolor=color.white, size=size.tiny)
        if alertEntry
            alert("HWR OB LONG  " + grd + " " + str.tostring(cf) + "%  close=" + str.tostring(close), alert.freq_once_per_bar_close)
    else
        label.new(bar_index, high, how + "OB " + side + " " + grd + " " + str.tostring(cf) + "%  매도" + str.tostring(vp, "#") + "%", xloc=xloc.bar_index, style=label.style_label_down, color=bearCol, textcolor=color.white, size=size.tiny)
        if alertEntry
            alert("HWR OB SHORT  " + grd + " " + str.tostring(cf) + "%  close=" + str.tostring(close), alert.freq_once_per_bar_close)
    if showBoxes
        bTp1 := f_zone(zEntry, zTp1, color.new(#26a69a, 78), color.new(#26a69a, 25))
        bTp2 := tpCount >= 2 ? f_zone(zTp1, zTp2, color.new(#4db6ac, 80), color.new(#26a69a, 25)) : na
        bTp3 := tpCount >= 3 ? f_zone(zTp2, zTp3, color.new(#80cbc4, 82), color.new(#26a69a, 25)) : na
        bSl := f_zone(zEntry, zSl, color.new(#ab47bc, 72), color.new(#ab47bc, 18))
        float avgPad0 = math.max(syminfo.mintick * 4, atrVal * 0.04)
        bAvg := f_zone(zAvg + avgPad0, zAvg - avgPad0, color.new(#e8ecf4, 70), color.new(#c8cdd8, 15))
        tTp1 := f_tag(zTp1, #26a69a, "TP1 " + str.tostring(q1Pct, "#") + "%", zTp1)
        tTp2 := tpCount >= 2 ? f_tag(zTp2, #4db6ac, "TP2 " + str.tostring(q2Pct, "#") + "%", zTp2) : na
        tTp3 := tpCount >= 3 ? f_tag(zTp3, #80cbc4, "TP3 " + str.tostring(q3Pct, "#") + "%", zTp3) : na
        tSl := f_tag(zSl, #ab47bc, "SL", zSl)
        tAvg := f_tag(zAvg, #c8cdd8, (openDir == 1 ? "롱" : "숏") + " 진입", zAvg)

if zLive and showBoxes and not wantWipe
    f_ext(bTp1)
    f_ext(bTp2)
    f_ext(bTp3)
    f_ext(bSl)
    f_ext(bAvg)
    if not na(tTp1)
        label.set_x(tTp1, bar_index)
    if not na(tTp2)
        label.set_x(tTp2, bar_index)
    if not na(tTp3)
        label.set_x(tTp3, bar_index)
    if not na(tSl)
        label.set_x(tSl, bar_index)
        label.set_y(tSl, zSl)
    if not na(tAvg)
        label.set_x(tAvg, bar_index)
        label.set_y(tAvg, zAvg)

closedTrades = wins + losses
pendingTrades = zLive ? 1 : 0
winRate = closedTrades > 0 ? wins / closedTrades * 100.0 : na
avgWinR = wins > 0 ? sumWinR / wins : 0.0
avgLossR = losses > 0 ? sumLossR / losses : 0.0
rrReal = avgLossR > 0 ? avgWinR / avgLossR : na
expR = closedTrades > 0 ? (wins * avgWinR - losses * avgLossR) / closedTrades : na

dashPos = dashPosIn == "오른쪽 아래" ? position.bottom_right : dashPosIn == "왼쪽 위" ? position.top_left : dashPosIn == "왼쪽 아래" ? position.bottom_left : dashPosIn == "가운데 위" ? position.top_center : dashPosIn == "가운데 아래" ? position.bottom_center : dashPosIn == "오른쪽 중간" ? position.middle_right : dashPosIn == "왼쪽 중간" ? position.middle_left : position.top_right
var table dash = table.new(position.top_right, 2, 17, bgcolor=color.new(#12141c, 12), border_color=color.new(#2a2e3a, 0), border_width=1)
if barstate.islast
    table.set_position(dash, dashPos)
f_cell(int r, string a, string b, color bc) =>
    table.cell(dash, 0, r, a, text_color=color.new(#c8cdd8, 0), text_halign=text.align_left, text_size=size.small)
    table.cell(dash, 1, r, b, text_color=bc, text_halign=text.align_right, text_size=size.small)

if showDash and barstate.islast
    wrTxt = closedTrades > 0 ? str.tostring(wins) + "/" + str.tostring(losses) + (nBe > 0 ? " 본절" + str.tostring(nBe) : "") + "  " + str.tostring(winRate, "#.0") + "%" : "-"
    if pendingTrades > 0
        wrTxt := wrTxt + "  진행"
    string posTxt = not zLive ? "없음" : (zDir == 1 ? "롱" : "숏")
    string boxTxt = not zLive ? "-" : "SL " + str.tostring(zSl, format.mintick) + "  TP1 " + str.tostring(zTp1, format.mintick)
    string demTxt = na(demTop) ? "없음" : (demUsed ? "사용됨 " : demLeft ? "리테스트 대기 " : "이탈 대기 ") + "매수" + str.tostring(demPct, "#") + "%"
    string supTxt = na(supTop) ? "없음" : (supUsed ? "사용됨 " : supLeft ? "리테스트 대기 " : "이탈 대기 ") + "매도" + str.tostring(supPct, "#") + "%"
    table.cell(dash, 0, 0, "HWR OB", text_color=color.white, text_halign=text.align_left, bgcolor=color.new(#1b1f2a, 0), text_size=size.small)
    table.cell(dash, 1, 0, timeframe.period, text_color=color.new(#8b95a8, 0), text_halign=text.align_right, bgcolor=color.new(#1b1f2a, 0), text_size=size.small)
    f_cell(1, "트레일", trailBull ? "상승" : trailBear ? "하락" : "접촉", trailBull ? bullCol : trailBear ? bearCol : color.gray)
    f_cell(2, "수요 블록", demTxt, na(demTop) ? color.gray : bullCol)
    f_cell(3, "공급 블록", supTxt, na(supTop) ? color.gray : bearCol)
    f_cell(4, "상위TF", htfBull ? "상승" : htfBear ? "하락" : "-", htfBull ? bullCol : htfBear ? bearCol : color.gray)
    f_cell(5, "ADX", not adxOk ? "횡보 " + str.tostring(adxVal, "#.0") : str.tostring(adxVal, "#.0"), adxOk ? bullCol : color.gray)
    f_cell(6, "포지션", posTxt, not zLive ? color.gray : zDir == 1 ? bullCol : bearCol)
    f_cell(7, "실시간 박스", boxTxt, zLive ? color.new(#c8cdd8, 0) : color.gray)
    f_cell(8, "계획 TP", str.tostring(tp1R, "#.##") + "/" + str.tostring(tp2R, "#.##") + "/" + str.tostring(tp3R, "#.##") + "R  " + str.tostring(q1Pct, "#") + "/" + str.tostring(q2Pct, "#") + "/" + str.tostring(q3Pct, "#") + "%", color.new(#c8cdd8, 0))
    f_cell(9, "승/패", wrTxt, not na(winRate) and winRate >= 50 ? bullCol : not na(winRate) and winRate < 40 ? bearCol : color.gray)
    f_cell(10, "실현 손익비", na(rrReal) ? "-" : str.tostring(rrReal, "#.##") + "  (" + str.tostring(avgWinR, "#.##") + "/" + str.tostring(avgLossR, "#.##") + "R)", na(rrReal) ? color.gray : rrReal >= 1.3 ? bullCol : bearCol)
    f_cell(11, "거래당 기대 R", na(expR) ? "-" : str.tostring(expR, "#.###"), na(expR) ? color.gray : expR >= 0 ? bullCol : bearCol)
    f_cell(12, "측정", statMode == "최근 N일" ? str.tostring(statDays) + "일" : statMode, color.new(#c8cdd8, 0))
    f_cell(13, "진입", "이탈 후 리테스트 + 거부봉. C는 최소확신도로 컷", color.new(#8b95a8, 0))
    f_cell(14, "손절", "블록 바깥 + ATR 가둠  " + str.tostring(slMinAtr, "#.##") + "~" + str.tostring(slMaxAtr, "#.##"), color.new(#8b95a8, 0))
    f_cell(15, "참고", "개념 재구성 · 원본 붙여넣기 아님", color.new(#8b95a8, 0))
    f_cell(16, "주의", "콤보와 같이 쓰지 말 것", color.new(#8b95a8, 0))

alertcondition(alertExit and closedNow, title="OB 청산", message="HWR OB EXIT")
