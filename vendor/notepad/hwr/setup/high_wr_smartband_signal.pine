//@version=5
indicator("스마트 밴드 시그널 [Smart Bands]", shorttitle="HWR SmartBand", overlay=true, scale=scale.right, max_labels_count=500, max_lines_count=50, max_boxes_count=100)

// ─────────────────────────────────────────────
// Market Waves Smart Bands 공개 설명 기반.
// 추세·변동성에 맞춰 폭이 바뀌는 리본.
// 상승=초록, 하락=빨강. 그림자는 그라데이션.
// 신호는 전환(밴드 돌파)과 리테스트(가장자리 터치 후 거부).
// 칼날 금지: 첫 터치가 아니라 대기 후 복귀 확인.
// 유료 원본 복제가 아님.
// ─────────────────────────────────────────────

// ===== 입력 =====
grpBand = "1. 스마트 밴드"
atrLen     = input.int(10, "ATR 기간", minval=1, group=grpBand)
stFactor   = input.float(2.40, "추세 민감도", minval=1.0, step=0.1, group=grpBand, tooltip="낮을수록 전환이 빠르고, 높을수록 추세를 오래 유지합니다.")
ribMult    = input.float(1.15, "리본 두께 ATR", minval=0.3, step=0.05, group=grpBand)
adaptVol   = input.bool(true, "변동성으로 폭 조절", group=grpBand)
adaptAdx   = input.bool(true, "추세 강도로 폭 조절", group=grpBand)
distLen    = input.int(60, "분포 기간", minval=20, group=grpBand)
htfTf      = input.timeframe("60", "상위 타임프레임", group=grpBand)
sigMode    = input.string("리테스트", "신호 방식", options=["리테스트", "전환", "둘 다"], group=grpBand)

grpMom = "2. 확인"
adxLen     = input.int(14, "ADX 기간", minval=2, group=grpMom)
adxMin     = input.float(16.0, "최소 ADX", minval=1, step=0.5, group=grpMom)
waitBars   = input.int(2, "터치 후 대기 봉", minval=1, maxval=8, group=grpMom)
tagBars    = input.int(8, "터치 유효 봉", minval=3, maxval=20, group=grpMom)
needRoom   = input.bool(true, "이탈 후 되돌림만", group=grpMom, tooltip="밴드에서 한 번 멀어진 뒤 다시 와야 리테스트입니다.")
rsiLen     = input.int(14, "RSI 기간", minval=2, group=grpMom)
rsiHot     = input.int(72, "RSI 과열 컷", minval=55, maxval=90, group=grpMom)

grpVol = "3. 손절·익절"
swingLen  = input.int(8, "스윙 손절 봉", minval=3, maxval=30, group=grpVol)
slPadAtr  = input.float(0.12, "손절 여유 ATR", minval=0.0, step=0.02, group=grpVol)
slMinAtr  = input.float(0.90, "손절 최소 ATR", minval=0.4, step=0.05, group=grpVol)
slMaxAtr  = input.float(2.00, "손절 최대 ATR", minval=0.8, step=0.05, group=grpVol)
tpCount   = input.int(2, "익절 분할 수", minval=1, maxval=3, group=grpVol)
tp1R      = input.float(0.80, "TP1 (R배수, 승률 기준)", minval=0.5, step=0.05, group=grpVol)
tp2R      = input.float(2.00, "TP2 (R배수)", minval=1.0, step=0.1, group=grpVol)
tp3R      = input.float(3.20, "TP3 (R배수)", minval=1.2, step=0.1, group=grpVol)
slToBe    = input.bool(true, "TP1 후 손절을 본절로", group=grpVol)
useTrail  = input.bool(true, "TP1 후 구조 트레일", group=grpVol)
trailBars = input.int(6, "트레일 스윙 봉", minval=3, maxval=20, group=grpVol)

grpBox = "3b. 구간 박스"
showBoxes   = input.bool(true, "TP/SL 구간 표시", group=grpBox)
useSplit    = input.bool(true, "최근 진입 분할선", group=grpBox)
splitN      = input.int(2, "진입 분할 수", minval=2, maxval=3, group=grpBox)
split2Pct   = input.float(40.0, "2차 위치 (진입~손절 %)", minval=10, maxval=80, step=1, group=grpBox)
split3Pct   = input.float(70.0, "3차 위치 (진입~손절 %)", minval=20, maxval=90, step=1, group=grpBox)
qty1        = input.int(55, "1차 비중 %", minval=1, maxval=90, group=grpBox)
qty2        = input.int(45, "2차 비중 %", minval=1, maxval=90, group=grpBox)
qty3        = input.int(0, "3차 비중 %", minval=0, maxval=90, group=grpBox)

grpSig = "4. 신호 품질"
cooldownBars = input.int(6, "신호 쿨다운(봉)", minval=1, group=grpSig)
minConv      = input.int(60, "최소 확신도", minval=0, maxval=90, group=grpSig)
requireHtf   = input.bool(true, "상위TF 방향 필수", group=grpSig)
requireAdx   = input.bool(true, "ADX 필수 (횡보 제외)", group=grpSig)
requireReject = input.bool(true, "양/음봉·거부봉만 진입", group=grpSig)
inBandOnly   = input.bool(true, "밴드 안에서만 리테스트", group=grpSig)

grpStat = "5. 측정기간"
statMode = input.string("최근 N일", "측정 방식", options=["전체", "최근 N일", "기간 지정"], group=grpStat)
statDays = input.int(60, "최근 N일", minval=1, maxval=3650, group=grpStat)
statFrom = input.time(timestamp("01 Jan 2026 00:00"), "시작", group=grpStat)
statTo   = input.time(timestamp("06 Sep 2026 23:59"), "종료", group=grpStat)
sessTz   = input.string("Asia/Seoul", "타임존", options=["Asia/Seoul", "America/New_York", "Europe/London", "UTC"], group=grpStat)

grpUi = "6. 표시"
showBand   = input.bool(true, "스마트 밴드 표시", group=grpUi)
showShadow = input.bool(true, "그림자", group=grpUi)
showDash   = input.bool(true, "대시보드 표시", group=grpUi)
dashPosIn  = input.string("오른쪽 위", "테이블 위치", options=["오른쪽 위", "오른쪽 아래", "왼쪽 위", "왼쪽 아래", "가운데 위", "가운데 아래", "오른쪽 중간", "왼쪽 중간"], group=grpUi)
bullCol    = input.color(color.new(#26a69a, 0), "상승 밴드 색", group=grpUi)
bearCol    = input.color(color.new(#ef5350, 0), "하락 밴드 색", group=grpUi)

// ===== 스마트 밴드 =====
atrVal = ta.atr(atrLen)
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
adxOk = adxVal > adxMin
volRank = ta.percentrank(atrVal, distLen) / 100.0
adxNorm = math.min(adxVal / 30.0, 1.40)
volK = adaptVol ? 0.78 + volRank * 0.55 : 1.0
adxK = adaptAdx ? 0.82 + adxNorm * 0.28 : 1.0
factor = stFactor * volK
[stLine, stDir] = ta.supertrend(factor, atrLen)
bull = stDir < 0
bear = stDir > 0
ribW = atrVal * ribMult * volK * adxK

// 추세 쪽 리본: 상승이면 지지선 위, 하락이면 저항선 아래
bandEdge = stLine
bandFar  = bull ? stLine + ribW : stLine - ribW
e1 = bull ? stLine + ribW * 0.34 : stLine - ribW * 0.34
e2 = bull ? stLine + ribW * 0.67 : stLine - ribW * 0.67
bandLo = math.min(bandEdge, bandFar)
bandHi = math.max(bandEdge, bandFar)
inBand = close >= bandLo and close <= bandHi
nearEdge = bull ? low <= bandEdge + atrVal * 0.08 : high >= bandEdge - atrVal * 0.08
priceSideOk = bull ? close >= bandEdge : close <= bandEdge

htfEma = request.security(syminfo.tickerid, htfTf, ta.ema(close, 21)[1], barmerge.gaps_off, barmerge.lookahead_off)
htfCls = request.security(syminfo.tickerid, htfTf, close[1], barmerge.gaps_off, barmerge.lookahead_off)
htfBull = htfCls > htfEma
htfBear = htfCls < htfEma

rsiVal = ta.rsi(close, rsiLen)
rsiLongOk = rsiVal <= rsiHot
rsiShortOk = rsiVal >= (100 - rsiHot)

rng = high - low
body = math.abs(close - open)
upperWick = high - math.max(close, open)
lowerWick = math.min(close, open) - low
midPx = (high + low) * 0.5
bullClose = close > open
bearClose = close < open
bodyOk = rng > 0 and body >= rng * 0.28
bullPin = rng > 0 and lowerWick >= rng * 0.34 and close >= midPx
bearPin = rng > 0 and upperWick >= rng * 0.34 and close <= midPx
bullEngulf = bullClose and close > high[1] and open <= math.max(open[1], close[1])
bearEngulf = bearClose and close < low[1] and open >= math.min(open[1], close[1])
rejectLong  = not requireReject or bullPin or bullEngulf or (bullClose and bodyOk)
rejectShort = not requireReject or bearPin or bearEngulf or (bearClose and bodyOk)
realRejL = bullPin or bullEngulf
realRejS = bearPin or bearEngulf

// 전환: 확정 종가가 밴드를 넘어 추세가 바뀜
flipUp = bull and bear[1]
flipDn = bear and bull[1]

// 리테스트: 추세 유지 중 가장자리 터치 → 대기 → 다시 힘
hadRoomL = not needRoom or ta.highest(close, tagBars) >= bandEdge + ribW * 0.35
hadRoomS = not needRoom or ta.lowest(close, tagBars) <= bandEdge - ribW * 0.35
barsFromLo = ta.barssince(bull and low <= bandEdge + atrVal * 0.08)
barsFromHi = ta.barssince(bear and high >= bandEdge - atrVal * 0.08)
waitedL = bull and not na(barsFromLo) and barsFromLo >= waitBars and barsFromLo <= tagBars
waitedS = bear and not na(barsFromHi) and barsFromHi >= waitBars and barsFromHi <= tagBars
heldTrendL = bull and close > bandEdge
heldTrendS = bear and close < bandEdge
bounceL = close > open and (close > high[1] or close > e1 or realRejL)
bounceS = close < open and (close < low[1] or close < e1 or realRejS)
bandGateL = not inBandOnly or inBand or close > bandEdge
bandGateS = not inBandOnly or inBand or close < bandEdge
retestL = waitedL and heldTrendL and hadRoomL and bounceL and bandGateL
retestS = waitedS and heldTrendS and hadRoomS and bounceS and bandGateS

useRt = sigMode == "리테스트" or sigMode == "둘 다"
useFl = sigMode == "전환" or sigMode == "둘 다"
setupL = (useRt and retestL) or (useFl and flipUp)
setupS = (useRt and retestS) or (useFl and flipDn)

f_conf(bool isLong) =>
    int pts = 0
    pts += (isLong ? bull : bear) ? 16 : 0
    pts += (isLong ? htfBull : htfBear) ? 12 : 0
    pts += adxOk ? 10 : 2
    pts += (isLong ? retestL : retestS) ? 14 : 0
    pts += (isLong ? flipUp : flipDn) ? 10 : 0
    pts += (isLong ? rsiLongOk : rsiShortOk) ? 8 : 0
    pts += (isLong ? realRejL : realRejS) ? 10 : 0
    pts += inBand ? 8 : 2
    pts += adxVal >= 22 ? 6 : 0
    pts += (isLong ? hadRoomL : hadRoomS) ? 6 : 0
    math.min(100, pts)

f_grade(int c) =>
    c >= 75 ? "A" : c >= 60 ? "B" : "C"
f_expLo(int c) =>
    math.max(48.0, 50.0 + (c - 50) * 0.12)
f_expHi(int c) =>
    math.min(66.0, 57.0 + (c - 50) * 0.16)

confLong = f_conf(true)
confShort = f_conf(false)
gradeLong = f_grade(confLong)
gradeShort = f_grade(confShort)

var int lastSigBar = na
cooled = na(lastSigBar) or (bar_index - lastSigBar >= cooldownBars)
htfGateL = not requireHtf or htfBull
htfGateS = not requireHtf or htfBear
adxGate = not requireAdx or adxOk
baseOk = barstate.isconfirmed and cooled and adxGate

longRaw  = baseOk and setupL and rejectLong and rsiLongOk and htfGateL and confLong >= minConv
shortRaw = baseOk and setupS and rejectShort and rsiShortOk and htfGateS and confShort >= minConv
longSignal  = longRaw and not shortRaw
shortSignal = shortRaw and not longRaw

if longSignal or shortSignal
    lastSigBar := bar_index

swingLo = ta.lowest(low, swingLen)
swingHi = ta.highest(high, swingLen)
f_sl(bool isLong, float px) =>
    raw = isLong ? math.min(swingLo, bandEdge) - atrVal * slPadAtr : math.max(swingHi, bandEdge) + atrVal * slPadAtr
    dist = math.abs(px - raw)
    adj = math.max(atrVal * slMinAtr, math.min(atrVal * slMaxAtr, dist))
    isLong ? px - adj : px + adj
f_tpR(bool isLong, float px, float sl, float rMult) =>
    risk = math.max(math.abs(px - sl), syminfo.mintick)
    isLong ? px + risk * rMult : px - risk * rMult
f_split(bool isLong, float px, float sl, float pct) =>
    isLong ? px - (px - sl) * pct / 100.0 : px + (sl - px) * pct / 100.0

// ===== 가상 승률 =====
var int[] tDir = array.new_int()
var float[] tEnt = array.new_float()
var float[] tSlA = array.new_float()
var float[] tTpA = array.new_float()
var int[] tGr = array.new_int()
var int[] tTm = array.new_int()
var int wins = 0
var int losses = 0
var int winsA = 0
var int lossesA = 0
var int winsB = 0
var int lossesB = 0
var int winsC = 0
var int lossesC = 0
var int firstTradeTime = na
var int lastCloseTime = na
int closedBefore = wins + losses
int lookFrom = timenow - statDays * 24 * 60 * 60 * 1000

f_inStat(int t) =>
    na(t) ? false : statMode == "전체" ? true : statMode == "최근 N일" ? (t >= lookFrom and t <= timenow) : (t >= statFrom and t <= statTo)
f_gradeId(string g) =>
    g == "A" ? 3 : g == "B" ? 2 : 1

if longSignal
    float sln = f_sl(true, close)
    array.push(tDir, 1)
    array.push(tEnt, close)
    array.push(tSlA, sln)
    array.push(tTpA, f_tpR(true, close, sln, tp1R))
    array.push(tGr, f_gradeId(gradeLong))
    array.push(tTm, time)
    if f_inStat(time) and na(firstTradeTime)
        firstTradeTime := time
if shortSignal
    float sls = f_sl(false, close)
    array.push(tDir, -1)
    array.push(tEnt, close)
    array.push(tSlA, sls)
    array.push(tTpA, f_tpR(false, close, sls, tp1R))
    array.push(tGr, f_gradeId(gradeShort))
    array.push(tTm, time)
    if f_inStat(time) and na(firstTradeTime)
        firstTradeTime := time

if array.size(tDir) > 0
    for i = array.size(tDir) - 1 to 0
        int d = array.get(tDir, i)
        float ent = array.get(tEnt, i)
        float slv = array.get(tSlA, i)
        float tpv = array.get(tTpA, i)
        int g = array.get(tGr, i)
        bool hitSl = d == 1 ? low <= slv : high >= slv
        bool hitTp = d == 1 ? high >= tpv : low <= tpv
        if hitSl or hitTp
            bool w = hitSl and hitTp ? (d == 1 ? close >= ent : close <= ent) : hitTp
            if f_inStat(array.get(tTm, i))
                if w
                    wins += 1
                else
                    losses += 1
                if g == 3
                    if w
                        winsA += 1
                    else
                        lossesA += 1
                else if g == 2
                    if w
                        winsB += 1
                    else
                        lossesB += 1
                else
                    if w
                        winsC += 1
                    else
                        lossesC += 1
            array.remove(tDir, i)
            array.remove(tEnt, i)
            array.remove(tSlA, i)
            array.remove(tTpA, i)
            array.remove(tGr, i)
            array.remove(tTm, i)

closedTrades = wins + losses
pendingTrades = array.size(tDir)
if closedTrades > closedBefore
    lastCloseTime := time
winRate = closedTrades > 0 ? wins / closedTrades * 100.0 : na

// ===== 플롯 =====
plot(close, "축고정", color=color.new(color.white, 100), linewidth=1, editable=false)
plot(high, "축고정H", color=color.new(color.white, 100), linewidth=1, editable=false)
plot(low, "축고정L", color=color.new(color.white, 100), linewidth=1, editable=false)

bandCol = bull ? bullCol : bear ? bearCol : color.gray
pEdge = plot(showBand ? bandEdge : na, "Smart Edge", color=bandCol, linewidth=2)
pE1   = plot(showBand ? e1 : na, "Smart L1", color=color.new(bandCol, 55), linewidth=1)
pE2   = plot(showBand ? e2 : na, "Smart L2", color=color.new(bandCol, 70), linewidth=1)
pFar  = plot(showBand ? bandFar : na, "Smart Far", color=color.new(bandCol, 80), linewidth=1)
fill(pEdge, pE1, color=showBand ? color.new(bandCol, showShadow ? 72 : 82) : na, title="Shadow 1")
fill(pE1, pE2, color=showBand and showShadow ? color.new(bandCol, 80) : na, title="Shadow 2")
fill(pE2, pFar, color=showBand and showShadow ? color.new(bandCol, 88) : na, title="Shadow 3")

// ===== 최근 진입 구간 =====
var bool zLive = false
var int zDir = 0
var float zSl = na
var float zTp1 = na
var float zTp2 = na
var float zTp3 = na
var float zE1 = na
var float zE2 = na
var float zE3 = na
var float zEntry = na
var bool zHit1 = false
var bool zHit2 = false
var bool zHit3 = false
var bool zBe = false
var bool zFill1 = false
var bool zFill2 = false
var bool zFill3 = false
var float zAvg = na
var box bTp1 = na
var box bTp2 = na
var box bTp3 = na
var box bSl = na
var box bE1 = na
var box bE2 = na
var box bE3 = na
var label tTp1 = na
var label tTp2 = na
var label tTp3 = na
var label tSl = na
var label tE1 = na
var label tE2 = na
var label tE3 = na
var box bAvg = na
var label tAvg = na

f_zone(float p1, float p2, color bg, color bd) =>
    box.new(bar_index, math.max(p1, p2), bar_index, math.min(p1, p2), xloc=xloc.bar_index, border_color=bd, border_width=1, bgcolor=bg)
f_tag(float y, color c, string name, float px) =>
    label.new(bar_index, y, name + "  " + str.tostring(px, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(c, 20), textcolor=color.white, size=size.tiny)
f_ext(b) =>
    if not na(b)
        box.set_right(b, bar_index)
    true
f_avgPx() =>
    float num = 0.0
    float den = 0.0
    if zFill1
        num += zE1 * qty1
        den += qty1
    if zFill2
        num += zE2 * qty2
        den += qty2
    if zFill3
        num += zE3 * qty3
        den += qty3
    den > 0 ? num / den : zE1
f_fillTxt() =>
    zFill3 ? "1·2·3차" : zFill2 ? "1·2차" : zFill1 ? "1차" : "-"

if showBoxes and (longSignal or shortSignal)
    box.delete(bTp1)
    box.delete(bTp2)
    box.delete(bTp3)
    box.delete(bSl)
    box.delete(bE1)
    box.delete(bE2)
    box.delete(bE3)
    label.delete(tTp1)
    label.delete(tTp2)
    label.delete(tTp3)
    label.delete(tSl)
    label.delete(tE1)
    label.delete(tE2)
    label.delete(tE3)
    box.delete(bAvg)
    label.delete(tAvg)
    bool isL = longSignal
    float px = close
    float slv = f_sl(isL, px)
    zLive := true
    zDir := isL ? 1 : -1
    zSl := slv
    zTp1 := f_tpR(isL, px, slv, tp1R)
    zTp2 := f_tpR(isL, px, slv, tp2R)
    zTp3 := f_tpR(isL, px, slv, tp3R)
    zE1 := px
    zE2 := f_split(isL, px, slv, split2Pct)
    zE3 := f_split(isL, px, slv, math.max(split3Pct, split2Pct + 5.0))
    zEntry := px
    zHit1 := false
    zHit2 := false
    zHit3 := false
    zBe := false
    zFill1 := true
    zFill2 := false
    zFill3 := false
    zAvg := px
    bTp1 := f_zone(zE1, zTp1, color.new(#26a69a, 78), color.new(#26a69a, 25))
    bTp2 := tpCount >= 2 ? f_zone(zTp1, zTp2, color.new(#4db6ac, 80), color.new(#26a69a, 25)) : na
    bTp3 := tpCount >= 3 ? f_zone(zTp2, zTp3, color.new(#80cbc4, 82), color.new(#26a69a, 25)) : na
    float slTop = useSplit ? (splitN == 3 ? zE3 : zE2) : zE1
    bSl := f_zone(slTop, zSl, color.new(#ab47bc, 72), color.new(#ab47bc, 18))
    bE1 := useSplit ? f_zone(zE1, (zE1 + zE2) * 0.5, color.new(#4da3ff, 78), color.new(#4da3ff, 25)) : na
    bE2 := useSplit ? f_zone((zE1 + zE2) * 0.5, splitN == 3 ? (zE2 + zE3) * 0.5 : zE2, color.new(#f0c14a, 78), color.new(#f0c14a, 25)) : na
    bE3 := useSplit and splitN == 3 ? f_zone((zE2 + zE3) * 0.5, zE3, color.new(#ff9f43, 78), color.new(#ff9f43, 25)) : na
    tTp1 := f_tag(zTp1, #26a69a, "TP1", zTp1)
    tTp2 := tpCount >= 2 ? f_tag(zTp2, #4db6ac, "TP2", zTp2) : na
    tTp3 := tpCount >= 3 ? f_tag(zTp3, #80cbc4, "TP3", zTp3) : na
    tSl := f_tag(zSl, #ab47bc, "SL", zSl)
    tE1 := useSplit ? f_tag(zE1, #4da3ff, "1차 진입 " + str.tostring(qty1) + "%", zE1) : na
    tE2 := useSplit ? f_tag(zE2, #f0c14a, "2차 대기 " + str.tostring(qty2) + "%", zE2) : na
    tE3 := useSplit and splitN == 3 ? f_tag(zE3, #ff9f43, "3차 대기 " + str.tostring(qty3) + "%", zE3) : na
    float avgPad0 = math.max(syminfo.mintick * 4, atrVal * 0.04)
    bAvg := f_zone(zAvg + avgPad0, zAvg - avgPad0, color.new(#e8ecf4, 70), color.new(#c8cdd8, 15))
    tAvg := f_tag(zAvg, #c8cdd8, "평단 1차", zAvg)

if zLive and showBoxes
    bool fill2Now = useSplit and not zFill2 and (zDir == 1 ? low <= zE2 : high >= zE2)
    bool fill3Now = useSplit and splitN == 3 and not zFill3 and (zDir == 1 ? low <= zE3 : high >= zE3)
    if fill2Now
        zFill2 := true
        if not na(tE2)
            label.set_text(tE2, "2차 진입 " + str.tostring(qty2) + "%  " + str.tostring(zE2, format.mintick))
    if fill3Now
        zFill3 := true
        if not na(tE3)
            label.set_text(tE3, "3차 진입 " + str.tostring(qty3) + "%  " + str.tostring(zE3, format.mintick))
    if fill2Now or fill3Now
        zAvg := f_avgPx()
        float avgPad = math.max(syminfo.mintick * 4, atrVal * 0.04)
        if not na(bAvg)
            box.set_top(bAvg, zAvg + avgPad)
            box.set_bottom(bAvg, zAvg - avgPad)
        if not na(tAvg)
            label.set_y(tAvg, zAvg)
            label.set_text(tAvg, "평단 " + f_fillTxt() + "  " + str.tostring(zAvg, format.mintick))
        if zBe
            zSl := zAvg
            if not na(tSl)
                label.set_y(tSl, zAvg)
                label.set_text(tSl, "본절  " + str.tostring(zAvg, format.mintick))
    bool touch1 = zDir == 1 ? high >= zTp1 : low <= zTp1
    bool touch2 = zDir == 1 ? high >= zTp2 : low <= zTp2
    bool touch3 = zDir == 1 ? high >= zTp3 : low <= zTp3
    if touch1 and not zHit1
        zHit1 := true
        if slToBe and tpCount >= 2
            zSl := zAvg
            zBe := true
            box.delete(bSl)
            label.delete(tSl)
            float bePad = math.max(syminfo.mintick * 4, atrVal * 0.05)
            bSl := f_zone(zAvg + bePad, zAvg - bePad, color.new(#f0c14a, 70), color.new(#f0c14a, 20))
            tSl := f_tag(zAvg, #f0c14a, "본절", zAvg)
    if tpCount >= 2 and touch2
        zHit2 := true
    if tpCount >= 3 and touch3
        zHit3 := true
    if zHit1 and useTrail
        float trailLv = zDir == 1 ? ta.lowest(low, trailBars) - atrVal * 0.08 : ta.highest(high, trailBars) + atrVal * 0.08
        float newSl = zDir == 1 ? math.max(zSl, math.max(zAvg, trailLv)) : math.min(zSl, math.min(zAvg, trailLv))
        if newSl != zSl
            zSl := newSl
            if not na(tSl)
                label.set_y(tSl, zSl)
                label.set_text(tSl, "트레일  " + str.tostring(zSl, format.mintick))
            if not na(bSl)
                float tPad = math.max(syminfo.mintick * 4, atrVal * 0.04)
                box.set_top(bSl, zSl + tPad)
                box.set_bottom(bSl, zSl - tPad)
    bool lastTpHit = tpCount == 1 ? zHit1 : tpCount == 2 ? zHit2 : zHit3
    bool touchSlNow = zDir == 1 ? low <= zSl : high >= zSl
    f_ext(bTp1)
    f_ext(bTp2)
    f_ext(bTp3)
    f_ext(bSl)
    f_ext(bE1)
    f_ext(bE2)
    f_ext(bE3)
    f_ext(bAvg)
    if not na(tTp1)
        label.set_x(tTp1, bar_index)
    if not na(tTp2)
        label.set_x(tTp2, bar_index)
    if not na(tTp3)
        label.set_x(tTp3, bar_index)
    if not na(tSl)
        label.set_x(tSl, bar_index)
        label.set_y(tSl, zSl)
    if not na(tE1)
        label.set_x(tE1, bar_index)
    if not na(tE2)
        label.set_x(tE2, bar_index)
    if not na(tE3)
        label.set_x(tE3, bar_index)
    if not na(tAvg)
        label.set_x(tAvg, bar_index)
        label.set_y(tAvg, zAvg)
    if touchSlNow or lastTpHit
        box.delete(bTp1)
        box.delete(bTp2)
        box.delete(bTp3)
        box.delete(bSl)
        box.delete(bE1)
        box.delete(bE2)
        box.delete(bE3)
        box.delete(bAvg)
        label.delete(tTp1)
        label.delete(tTp2)
        label.delete(tTp3)
        label.delete(tSl)
        label.delete(tE1)
        label.delete(tE2)
        label.delete(tE3)
        label.delete(tAvg)
        bTp1 := na
        bTp2 := na
        bTp3 := na
        bSl := na
        bE1 := na
        bE2 := na
        bE3 := na
        bAvg := na
        tTp1 := na
        tTp2 := na
        tTp3 := na
        tSl := na
        tE1 := na
        tE2 := na
        tE3 := na
        tAvg := na
        zLive := false
        bool isBe = zBe and zHit1 and not zHit2 and not zHit3 and touchSlNow
        string resTxt = zHit3 ? "TP3 성공" : zHit2 ? "TP2 성공" : isBe ? "본절" : zHit1 ? "TP1 성공" : "SL 실패"
        bool winZ = zHit1 or zHit2 or zHit3
        color resCol = zHit2 or zHit3 or (zHit1 and not isBe) ? bullCol : isBe ? color.new(#f0c14a, 0) : bearCol
        bool resBelow = (zDir == 1 and not winZ) or (zDir == -1 and winZ)
        label.new(bar_index, resBelow ? low : high, resTxt, xloc=xloc.bar_index, style=resBelow ? label.style_label_up : label.style_label_down, color=resCol, textcolor=color.white, size=size.tiny)
        alert("HWR SmartBand " + resTxt + "  close=" + str.tostring(close), alert.freq_once_per_bar)

if longSignal
    string kindL = flipUp ? "전환" : "리테스트"
    label.new(bar_index, low, kindL + " 롱 " + gradeLong + " " + str.tostring(confLong) + "%", xloc=xloc.bar_index, style=label.style_label_up, color=bullCol, textcolor=color.white, size=size.tiny)
if shortSignal
    string kindS = flipDn ? "전환" : "리테스트"
    label.new(bar_index, high, kindS + " 숏 " + gradeShort + " " + str.tostring(confShort) + "%", xloc=xloc.bar_index, style=label.style_label_down, color=bearCol, textcolor=color.white, size=size.tiny)

// ===== 대시보드 =====
dashPos = dashPosIn == "오른쪽 아래" ? position.bottom_right : dashPosIn == "왼쪽 위" ? position.top_left : dashPosIn == "왼쪽 아래" ? position.bottom_left : dashPosIn == "가운데 위" ? position.top_center : dashPosIn == "가운데 아래" ? position.bottom_center : dashPosIn == "오른쪽 중간" ? position.middle_right : dashPosIn == "왼쪽 중간" ? position.middle_left : position.top_right
var table dash = table.new(position.top_right, 2, 14, bgcolor=color.new(#12141c, 12), border_color=color.new(#2a2e3a, 0), border_width=1)
if barstate.islast
    table.set_position(dash, dashPos)
f_cell(int r, string a, string b, color bc) =>
    table.cell(dash, 0, r, a, text_color=color.new(#c8cdd8, 0), text_halign=text.align_left, text_size=size.small)
    table.cell(dash, 1, r, b, text_color=bc, text_halign=text.align_right, text_size=size.small)

if showDash and barstate.islast
    wrTxt = closedTrades > 0 ? str.tostring(wins) + "/" + str.tostring(losses) + "  " + str.tostring(winRate, "#.0") + "%" : "-"
    if pendingTrades > 0
        wrTxt := wrTxt + "  진행" + str.tostring(pendingTrades)
    int liveConf = confLong >= confShort ? confLong : confShort
    string liveGrade = confLong >= confShort ? gradeLong : gradeShort
    string liveSide = confLong >= confShort ? "L" : "S"
    string expTxt = str.tostring(f_expLo(liveConf), "#") + "-" + str.tostring(f_expHi(liveConf), "#") + "%"
    int closedA = winsA + lossesA
    int closedB = winsB + lossesB
    string wrA = closedA > 0 ? str.tostring(winsA) + "/" + str.tostring(lossesA) + "  " + str.tostring(winsA / closedA * 100.0, "#.0") + "%" : "-"
    string wrB = closedB > 0 ? str.tostring(winsB) + "/" + str.tostring(lossesB) + "  " + str.tostring(winsB / closedB * 100.0, "#.0") + "%" : "-"
    color convC = liveConf >= 75 ? bullCol : liveConf >= 60 ? color.new(#f0c14a, 0) : color.gray
    string stTxt = flipUp ? "상승 전환" : flipDn ? "하락 전환" : bull ? "상승 리본" : bear ? "하락 리본" : "중립"
    color stC = bull ? bullCol : bear ? bearCol : color.gray
    string pxTxt = nearEdge ? (bull ? "하단 리테스트" : "상단 리테스트") : inBand ? "밴드 안" : priceSideOk ? "추세 쪽" : "밴드 이탈"
    table.cell(dash, 0, 0, "HWR SmartBand", text_color=color.white, text_halign=text.align_left, bgcolor=color.new(#1b1f2a, 0), text_size=size.small)
    table.cell(dash, 1, 0, timeframe.period + " / HTF " + htfTf, text_color=color.new(#8b95a8, 0), text_halign=text.align_right, bgcolor=color.new(#1b1f2a, 0), text_size=size.small)
    f_cell(1, "밴드", stTxt, stC)
    f_cell(2, "위치", pxTxt, nearEdge ? color.new(#f0c14a, 0) : priceSideOk ? bullCol : bearCol)
    f_cell(3, "두께", str.tostring(volRank * 100.0, "#") + "% vol", adaptVol ? color.white : color.gray)
    f_cell(4, "ADX", not adxOk ? "횡보 " + str.tostring(adxVal, "#.0") : str.tostring(adxVal, "#.0"), adxOk ? bullCol : color.gray)
    f_cell(5, "상위TF", htfBull ? "롱 우세" : htfBear ? "숏 우세" : "중립", htfBull ? bullCol : htfBear ? bearCol : color.gray)
    f_cell(6, "확신도", liveSide + " " + liveGrade + " " + str.tostring(liveConf) + "%", convC)
    f_cell(7, "추정 승률", expTxt, convC)
    f_cell(8, "분할", zLive ? f_fillTxt() : "-", zFill2 ? bullCol : zLive ? color.new(#f0c14a, 0) : color.gray)
    f_cell(9, "평단", zLive and not na(zAvg) ? str.tostring(zAvg, format.mintick) : "-", zLive ? color.white : color.gray)
    string perTxt = statMode == "기간 지정" ? str.format_time(statFrom, "yy.MM.dd HH:mm", sessTz) + " ~ " + str.format_time(statTo, "yy.MM.dd HH:mm", sessTz) : statMode == "최근 N일" ? str.format_time(lookFrom, "yy.MM.dd HH:mm", sessTz) + " ~ " + str.format_time(timenow, "yy.MM.dd HH:mm", sessTz) : na(firstTradeTime) ? "-" : str.format_time(firstTradeTime, "yy.MM.dd HH:mm", sessTz) + " ~ " + (na(lastCloseTime) ? "진행중" : str.format_time(lastCloseTime, "yy.MM.dd HH:mm", sessTz))
    f_cell(10, "승/패", wrTxt, not na(winRate) and winRate >= 52 ? bullCol : not na(winRate) and winRate < 42 ? bearCol : color.gray)
    f_cell(11, "측정기간", perTxt, closedTrades > 0 ? color.white : color.gray)
    f_cell(12, "A등급 실측", wrA, closedA > 0 ? bullCol : color.gray)
    f_cell(13, "B등급 실측", wrB, closedB > 0 ? color.new(#f0c14a, 0) : color.gray)

alertcondition(longSignal, title="스마트밴드 롱", message="HWR SmartBand LONG")
alertcondition(shortSignal, title="스마트밴드 숏", message="HWR SmartBand SHORT")
if longSignal
    alert("HWR SmartBand LONG  " + gradeLong + " 확신 " + str.tostring(confLong) + "%  close=" + str.tostring(close), alert.freq_once_per_bar_close)
if shortSignal
    alert("HWR SmartBand SHORT  " + gradeShort + " 확신 " + str.tostring(confShort) + "%  close=" + str.tostring(close), alert.freq_once_per_bar_close)
