# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Bybit (USDT Perpetual / linear)
BYBIT_API_KEY=
BYBIT_API_SECRET=
# BYBIT_BASE_URL=https://api.bybit.com
# 테스트넷: https://api-testnet.bybit.com

# Binance Futures (USDT-M)
BINANCE_API_KEY=
BINANCE_API_SECRET=
# BINANCE_BASE_URL=https://fapi.binance.com
# 테스트넷: https://testnet.binancefuture.com

# OKX (USDT SWAP)
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
# OKX_BASE_URL=https://www.okx.com

# Upbit (현물) — Access + Secret 둘 다 필요
# 동기화는 로컬(허용 IP 등록)에서 1회 → DB 저장. Vercel에서는 DB만 읽음
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# 앱 로그인 (개인용 잠금) — Vercel Environment Variables에도 동일 등록
APP_AUTH_USER=your_id
APP_AUTH_PASSWORD=your_password
# 선택: 세션 서명 키 (없으면 user+password로 유도)
# APP_AUTH_SECRET=long-random-string
